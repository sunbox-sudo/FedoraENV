#!/bin/bin/env bash
# =============================================================================
# stages/_template.sh - template for a FedoraENV stage
# =============================================================================
# HOW TO USE
#   1. Copy this file:  cp stages/_template.sh stages/neovim.sh
#   2. Replace every neovim / TODO below.
#   3. Add neovim to STAGES=(...) in the machine profile (machines/...).
#   The leading underscore keeps this template from ever being run by mistake.
#
# HOW A STAGE RUNS
#   fedora-env SOURCES this file and then calls stage_run. It has already
#   printed the stage heading, so do not print one yourself.
#   Everything from lib/ is available: log_*, check_*, pkg_*, reboot_*.
#   Per-machine settings from the profile (e.g. HAS_NVIDIA=0) are plain
#   variables here.
#
# RULES FOR A GOOD STAGE
#   - Idempotent: running it twice must give the same result and no errors.
#     Check before you change something, skip with a log_info when it is done.
#   - Define ONLY functions at the top level. Nothing runs when sourced.
#   - stage_run is the one entry point. Put real work in helper functions
#     named _neovim_something, because all stages share one namespace.
#   - Use "local" for variables inside functions.
#   - Run commands that write output through log_run, so they land in the log.
#   - Stop with log_die when the stage cannot continue. Do not carry on half done.
#   - Need a reboot afterwards? reboot_request "why".
#   - Do not call "exit" and do not change "set -e". The main script owns both.
# =============================================================================

# -----------------------------------------------------------------------------
# _neovim_install_packages
#   Install what the stage needs. pkg_install skips packages that are already
#   installed.
# -----------------------------------------------------------------------------
_neovim_install_packages() {
  pkg_install neovim luarocks
}

# -----------------------------------------------------------------------------
# stage_run
#   The entry point fedora-env calls. Keep it short: it just calls the helpers
#   in order, so it reads like a table of contents.
# -----------------------------------------------------------------------------
stage_run() {
  _neovim_install_packages
  # reboot_request "TODO: reason, only if this stage really needs one"
}
